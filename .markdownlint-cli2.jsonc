{
  // markdownlint-cli2 runs bare, in CI and on a laptop, so the globs live here.
  "globs": ["**/*.md"],
  "ignores": [
    // A trimmed vendored copy: the markdown is upstream's, not this project's
    // prose, and the humanizer pass does not reach into it.
    "tree_sitter_v/**",
    // Agent tooling keeps rules, prompts, skills and chat history in a
    // directory named after the tool, one line per tool. That is local state
    // for whoever is working in the tree, not this project's prose. Aider
    // writes its history beside the config file instead of in a directory.
    "**/.aider*/**",
    "**/.aider*.md",
    "**/.agent/**",
    "**/.agents/**",
    "**/.amazonq/**",
    "**/.augment/**",
    "**/.claude/**",
    "**/.cline/**",
    "**/.clinerules/**",
    "**/.codebuddy/**",
    "**/.codex/**",
    "**/.cognition/**",
    "**/.cody/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.factory/**",
    "**/.gemini/**",
    "**/.iflow/**",
    "**/.junie/**",
    "**/.kilocode/**",
    "**/.kiro/**",
    "**/.kode/**",
    "**/.omh/**",
    "**/.omo/**",
    "**/.omx/**",
    "**/.opencode/**",
    "**/.openhands/**",
    "**/.pi/**",
    "**/.qwen/**",
    "**/.roo/**",
    "**/.ruler/**",
    "**/.specstory/**",
    "**/.tabnine/**",
    "**/.trae/**",
    "**/.vibe/**",
    "**/.windsurf/**",
    "**/.zed/**",
    "node_modules/**",
  ],
  "config": {
    "default": true,
    // Prose is wrapped by hand at 78 columns and reviewed for it, but tables,
    // badge markup and measured command output run long on purpose.
    "MD013": false,
    // The front page opens with centred HTML, and the pull request template
    // starts at h2 because GitHub draws the section header above it.
    "MD041": false,
    // Same reason: the front page is built from these four elements.
    "MD033": { "allowed_elements": ["a", "h1", "img", "p"] }
  }
}
